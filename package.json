{
  "name": "manicure-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Демо онлайн-записи в вымышленную студию маникюра",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "tsx scripts/local-db.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "jose": "^6.2.15",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "vitest": "^5.1.0"
  }
}
