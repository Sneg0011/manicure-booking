# Настройки проекта. Скопируйте этот файл в .env.local и заполните значения.
# Файл .env.local содержит секреты: его нельзя коммитить и никому нельзя отправлять.

# ---------- База данных ----------

# Обязательно. Адрес базы для работы сайта.
# Для локального запуска подойдёт строка ниже: это локальная база на вашем компьютере, а не секрет.
# На Neon сюда идёт строка подключения через пул (pooled).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54320/manicure

# Только для размещения. Прямая строка подключения Neon для миграций (direct).
# Локально можно не указывать, тогда миграции идут через DATABASE_URL.
DATABASE_URL_DIRECT=

# Необязательно. Порт локальной базы для npm run db:start, по умолчанию 54320.
LOCAL_DB_PORT=

# ---------- Вход менеджера ----------

# Обязательно для входа в /admin. Логин менеджера.
MANAGER_LOGIN=

# Обязательно для входа в /admin. Хэш пароля, а не сам пароль. Получить:
#   npm run hash-password -- "ваш пароль"
# Значение вставляется как есть, с двоеточиями и без кавычек.
MANAGER_PASSWORD_HASH=

# Обязательно для входа в /admin. Случайная строка не короче 16 символов. Получить:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ---------- Демо-режим и ежедневная задача ----------

# true включает ежедневный сброс демо-данных. Без этого значения сброса нет.
# Для настоящих клиентов не указывать, иначе данные будут стираться каждый день.
DEMO_MODE=true

# Обязательно для ежедневной задачи /api/cron/daily. Случайная строка, как SESSION_SECRET.
CRON_SECRET=

# Необязательно. Сколько записей в час можно создать с одного адреса, по умолчанию 5.
RATE_LIMIT_BOOKINGS_PER_HOUR=

# ---------- Telegram-бот (необязательно: без него работают сайт и панель) ----------

# Токен бота от @BotFather. Никому не отправляйте его, в том числе в чат с ассистентом.
TELEGRAM_BOT_TOKEN=

# Имя бота без @, например lunka_demo_bot. Без него на сайте нет кнопки подключения бота.
BOT_USERNAME=

# Случайная строка, как SESSION_SECRET. Telegram присылает её с каждым обновлением.
TELEGRAM_WEBHOOK_SECRET=

# Секретные части ссылок привязки двух мастеров: https://t.me/<бот>?start=master_<секрет>
# Только латиница, цифры, _ и -, не длиннее 57 символов. Получить:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MASTER_1_INVITE=
MASTER_2_INVITE=

# Только для проверки без настоящего Telegram: адрес заглушки из npm run telegram:stub.
# Значение для заглушки: http://127.0.0.1:54321 . В работе оставить пустым.
TELEGRAM_API_ROOT=

# Необязательно. Порт заглушки Telegram, по умолчанию 54321.
TELEGRAM_STUB_PORT=
